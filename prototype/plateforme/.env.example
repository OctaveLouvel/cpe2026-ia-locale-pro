# Configuration de la box. `./box.sh installer` copie ce fichier en .env et génère les secrets vides.
# Le fichier .env contient des mots de passe : il est ignoré par git, ne jamais le committer.

# Nom de domaine local de la box. « cabinet.localhost » fonctionne sans configuration sur la machine
# elle-même. Pour y accéder depuis un autre poste : « cabinet.internal » (domaine réservé à l'usage
# privé) + une ligne dans le fichier hosts du poste (voir README.md).
BOX_DOMAIN=cabinet.localhost
BOX_NOM="Box du cabinet"

# Adresse d'écoute : 127.0.0.1 = accessible depuis cette machine seulement (développement, wifi de
# l'école). 0.0.0.0 = accessible depuis le réseau local du cabinet (box réelle, démo avec câble).
BIND_ADDRESS=127.0.0.1

# Compte administrateur technique de Nextcloud (pas un compte du cabinet).
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=

# Secrets internes entre services.
NC_DB_PASSWORD=
CACHE_PASSWORD=
# Jeton de la page d'administration du coffre-fort (https://coffre.<domaine>/admin).
VW_ADMIN_TOKEN=

# Assistant IA (DEV-2) : moteur Colibri déjà installé sur la machine (./box.sh moteur-ia demarrer).
COLIBRI_DIR=
COLIBRI_MODELE=
IA_MOTEUR=openai
IA_MOTEUR_URL=
IA_MOTEUR_CLE=
IA_MODELE=qwen3.6-colibri
# Recherche par le sens (option Ollama) : vide = recherche par mots.
IA_EMBEDDINGS_URL=
IA_MODELE_EMBEDDINGS=embeddinggemma-2:270m
# Géré par ./box.sh ia : « ollama » démarre le conteneur ia-moteur.
COMPOSE_PROFILES=

# Mot de passe commun des 4 comptes FICTIFS du jeu de démonstration.
DEMO_MOT_DE_PASSE=

# Sauvegarde chiffrée (restic). Dossier sur le disque externe, et phrase de passe du dépôt.
# Sans cette phrase de passe, la sauvegarde est illisible, y compris pour nous : la noter sur la
# fiche de secours remise au cabinet.
SAUVEGARDE_DESTINATION=
SAUVEGARDE_MOT_DE_PASSE=
