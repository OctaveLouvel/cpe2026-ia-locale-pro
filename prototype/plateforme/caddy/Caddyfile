# Reverse proxy TLS de la box (DEV-1).
# Tous les certificats sont signés par l'autorité de certification locale de Caddy :
# aucune demande à une autorité publique, tout fonctionne câble débranché.
# Les postes du cabinet doivent faire confiance au certificat racine (voir README.md).
{
	local_certs
	skip_install_trust
	servers {
		protocols h1 h2
	}
	pki {
		ca local {
			name "asoterIA"
			root_cn "asoterIA - autorite racine locale"
			intermediate_cn "asoterIA - autorite intermediaire"
		}
	}
}

(entetes) {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

# Seule ressource servie sans TLS : le certificat racine, pour l'installer sur les postes.
# Vérifier son empreinte (affichée par ./box.sh installer) avant de lui faire confiance.
http://{$BOX_DOMAIN} {
	handle /autorite-locale.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	handle {
		redir https://{host}{uri} 308
	}
}

# Tableau de bord de la box (DEV-3) : page d'accueil des postes du cabinet.
{$BOX_DOMAIN} {
	import entetes
	# Le coffre-fort est sur un réseau que seul le proxy joint : sa route de santé passe donc par ici.
	handle /etat/coffre {
		rewrite * /alive
		reverse_proxy coffre:80
	}
	# Connexion unique (servie par l'assistant, qui ouvre la session Nextcloud de la personne).
	@connexion path /connexion /deconnexion /api/connexion /api/deconnexion /api/session
	handle @connexion {
		reverse_proxy assistant:8000
	}
	handle {
		forward_auth assistant:8000 {
			uri /api/verifier?service=accueil
		}
		reverse_proxy tableau-de-bord:8000
	}
}

# Fichiers, agenda, contacts.
cloud.{$BOX_DOMAIN} {
	import entetes
	redir /.well-known/carddav /remote.php/dav/ 301
	redir /.well-known/caldav /remote.php/dav/ 301
	# Se déconnecter de Nextcloud, c'est se déconnecter de la box (sinon la connexion unique la rouvre aussitôt).
	@sortie path /logout /index.php/logout
	redir @sortie https://{$BOX_DOMAIN}/deconnexion 303
	request_body {
		max_size 4GB
	}
	# Connexion unique : l'assistant donne le mot de passe d'application de la personne connectée à la box.
	# Les applications de synchronisation, qui envoient leurs propres identifiants, ne sont pas concernées.
	forward_auth assistant:8000 {
		uri /api/verifier?service=cloud
		copy_headers Authorization
	}
	reverse_proxy nextcloud:80
}

# Coffre-fort de mots de passe.
coffre.{$BOX_DOMAIN} {
	import entetes
	reverse_proxy coffre:80
}

# Services des autres équipes : un fichier <service>.caddy par service dans caddy/sites/.
import sites/*.caddy
